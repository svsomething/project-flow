#!/usr/bin/env python3
"""
project-monitor — polls a GitHub Project v2 board and dispatches Claude
to handle Plan and Implement column items.

Column logic:
  Plan      → post a plan as a comment if none exists yet;
              reply to any user comment not yet responded to
  Implement → implement the plan autonomously, open PRs, move to In Review
  In Review → move to Done when all linked PRs are merged

Reads all deployment-specific values from config.yaml (see docs/setup.md).
Intended to run as a cron job every minute alongside pr-monitor.
Logs to stdout (redirect to ~/.claude/project-monitor.log in crontab).
"""

import json
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML not installed. Run: pip install pyyaml", flush=True)
    raise SystemExit(1)

# Locate config.yaml relative to this script (../../config.yaml)
_SCRIPT_DIR = Path(__file__).resolve().parent
CONFIG_FILE  = _SCRIPT_DIR.parent / "config.yaml"
LOCK_FILE    = Path.home() / ".claude" / "project-monitor.lock"

sys.path.insert(0, str(_SCRIPT_DIR))
import claude_runner  # noqa: E402  (shared hardened Claude CLI wrapper)


# ------------------------------------------------------------- in-flight state
#
# Each dispatching action posts a start marker before it works and a finish
# marker when it is done. The guards below skip a card while a start marker has
# no matching finish marker — that is what stops two runs of the same card from
# duplicating each other's work across polls.
#
# Markers are HTML-comment sentinels on the *first line* of the comment, matched
# with startswith(). Two properties matter:
#
#   * First-line matching is what makes the guard safe. The previous guards were
#     bare substring tests, so a plan comment that merely mentioned a marker
#     phrase blocked its own card forever (#30 — this happened to #27 on
#     2026-09-07, with no run ever attempted). A plan comment starts with
#     "## Plan", so under first-line matching no plan can trip a guard no matter
#     what its body quotes.
#   * The sentinel is invisible when rendered and decouples dispatch from the
#     human-facing heading, so the wording can change without breaking matching.
#
# The four posting sites live in project-workflow/SKILL.md and the two auth
# sentinels in claude_runner.py. Both sides must move together.
SENTINEL_PREFIX = "<!-- pf:"

PLAN_START   = "<!-- pf:plan-started -->"
PLAN_FINISH  = "<!-- pf:plan-finished -->"
IMPL_START   = "<!-- pf:implement-started -->"
IMPL_FINISH  = "<!-- pf:implement-finished -->"
DONE_START   = "<!-- pf:done-started -->"
DONE_FINISH  = "<!-- pf:done-finished -->"
RETRY        = "<!-- pf:retry -->"

# Visible headings used before the sentinels existed. Recognised as first-line
# markers so cards already carrying a real marker keep their state across the
# deploy. A legacy comment that only *quotes* a heading mid-body correctly stops
# matching — that is the fix.
LEGACY_IMPL_START  = "## Starting implementation"
LEGACY_IMPL_FINISH = "## Implementation complete"
LEGACY_DONE_START  = "## Merging PRs"
LEGACY_DONE_FINISH = "## Done"

IMPL_START_MARKERS  = (IMPL_START, LEGACY_IMPL_START)
IMPL_FINISH_MARKERS = (IMPL_FINISH, LEGACY_IMPL_FINISH)
DONE_START_MARKERS  = (DONE_START, LEGACY_DONE_START)
DONE_FINISH_MARKERS = (DONE_FINISH, LEGACY_DONE_FINISH)
PLAN_START_MARKERS  = (PLAN_START,)
PLAN_FINISH_MARKERS = (PLAN_FINISH,)

# Bot comments that are not plans and must never be read as one. Anything the
# bot posts for an unrelated purpose (an auth alert, a stale-run retry, an
# implement/done marker) counted as "a plan exists" under the old
# "any bot comment" test — that is how an auth alert on a Plan card suppressed
# planning permanently.
NON_PLAN_MARKERS = (
    SENTINEL_PREFIX,
    LEGACY_IMPL_START, LEGACY_IMPL_FINISH,
    LEGACY_DONE_START, LEGACY_DONE_FINISH,
    claude_runner.ALERT_HEADING, claude_runner.RESUME_HEADING,
)

# A start marker older than this is treated as a dead run and re-dispatched.
# Must stay comfortably above claude_runner.TIMEOUT_SECONDS: past that ceiling
# the invocation is killed and the PID lock released, so an older marker is
# provably not a live run. tests/test_project_monitor.py asserts the margin, so
# raising TIMEOUT_SECONDS past 30 min fails a test rather than silently letting
# a running card be declared stale.
STALE_AFTER = timedelta(minutes=60)

CLEAR   = "clear"
RUNNING = "running"
STALE   = "stale"


def parse_ts(value):
    """Parse a GitHub ISO-8601 timestamp into an aware datetime."""
    dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


# Cards request a model in natural language ("please use Opus for this one")
# rather than a fixed directive syntax, so this scans for the three CLI
# aliases as whole words anywhere in the issue body. First match (in reading
# order) wins — a body mentioning two aliases doesn't get smarter disambiguation,
# since that would need actual NLU rather than a regex.
MODEL_KEYWORD_RE = re.compile(r'\b(opus|sonnet|haiku)\b', re.IGNORECASE)


def parse_requested_model(body):
    """Return the first model alias mentioned in the issue body, or None."""
    match = MODEL_KEYWORD_RE.search(body or "")
    return match.group(1).lower() if match else None


def starts_with_marker(body, markers):
    """True if the comment body's first line begins with one of `markers`."""
    return (body or "").lstrip().startswith(tuple(markers))


def in_flight_state(bot_comments, start_markers, finish_markers, now=None):
    """Return CLEAR / RUNNING / STALE for one start/finish marker pair.

    CLEAR   — no start marker, or a finish marker was posted after the newest one
    RUNNING — a start marker is unmatched and younger than STALE_AFTER
    STALE   — a start marker is unmatched and older than STALE_AFTER, so the run
              that posted it is dead and the card should be re-dispatched

    `now` is a parameter so tests can exercise expiry without freezing the clock.
    """
    now      = now or datetime.now(timezone.utc)
    ordered  = sorted(bot_comments, key=lambda c: c["createdAt"])
    starts   = [c for c in ordered if starts_with_marker(c["body"], start_markers)]
    if not starts:
        return CLEAR, None

    start = starts[-1]
    if any(c["createdAt"] > start["createdAt"]
           and starts_with_marker(c["body"], finish_markers) for c in ordered):
        return CLEAR, None

    if parse_ts(start["createdAt"]) < now - STALE_AFTER:
        return STALE, start
    return RUNNING, start


def post_retry_notice(repo, number, action, started_at, cfg):
    """Tell the card it is being retried, so the state change is visible on it.

    Self-limiting: the re-dispatched run posts a fresh start marker, so a card
    can produce at most one of these per STALE_AFTER.
    """
    minutes = int(STALE_AFTER.total_seconds() // 60)
    body = (
        f"{RETRY}\n"
        "## ♻️ Retrying a stale run\n\n"
        f"The previous `{action}` run started at {started_at} and never reported "
        f"completion within {minutes} minutes, so the process that started it is "
        "assumed dead. Picking this card up again now — no action needed."
    )
    result = subprocess.run(
        ["gh", "api", f"repos/{repo}/issues/{number}/comments", "-f", f"body={body}"],
        capture_output=True, text=True, env=bot_env(cfg),
    )
    if result.returncode != 0:
        log(f"  ERROR: could not post retry notice on {repo}#{number}: "
            f"{result.stderr.strip()}")


def check_in_flight(action, item_issue, bot_comments, start_markers,
                    finish_markers, cfg):
    """Shared guard for all three columns. True means "skip this card".

    A stale marker logs a WARN, posts the retry notice, and falls through to a
    fresh dispatch rather than leaving the card stuck forever.
    """
    number = item_issue["number"]
    repo   = item_issue["repository"]["nameWithOwner"]
    state, start = in_flight_state(bot_comments, start_markers, finish_markers)
    if state == RUNNING:
        log(f"  {action}: issue #{number} already in flight, skipping")
        return True
    if state == STALE:
        log(f"  WARN: retrying stale in-flight card #{number} "
            f"({action} started {start['createdAt']})")
        post_retry_notice(repo, number, action, start["createdAt"], cfg)
    return False


def load_config():
    if not CONFIG_FILE.exists():
        raise FileNotFoundError(
            f"config.yaml not found at {CONFIG_FILE}. "
            "Copy config.yaml from project-flow and fill in your values."
        )
    with open(CONFIG_FILE) as f:
        return yaml.safe_load(f)


def log(msg):
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    print(f"[{ts}] {msg}", flush=True)


def bot_env(cfg):
    env = os.environ.copy()
    token_file = Path(cfg["github"]["bot_token_file"]).expanduser()
    if token_file.exists():
        mode = oct(token_file.stat().st_mode)[-3:]
        if mode != "600":
            log(f"WARNING: {token_file} has permissions {mode}, should be 600")
        env["GH_TOKEN"] = token_file.read_text().strip()
    return env


def gql(query, variables, cfg):
    payload = {"query": query}
    if variables:
        payload["variables"] = variables
    result = subprocess.run(
        ["gh", "api", "graphql", "--input", "-"],
        input=json.dumps(payload),
        capture_output=True, text=True, env=bot_env(cfg)
    )
    if result.returncode != 0:
        raise RuntimeError(f"GraphQL error: {result.stderr.strip()}")
    data = json.loads(result.stdout)
    if "errors" in data:
        raise RuntimeError(f"GraphQL errors: {data['errors']}")
    return data["data"]


def get_plan_items(cfg):
    """Return project items currently in Plan, Implement, or In Review columns."""
    owner  = cfg["github"]["org"]
    number = cfg["project"]["number"]
    data = gql("""
    query($owner: String!, $number: Int!) {
      user(login: $owner) {
        projectV2(number: $number) {
          items(first: 50) {
            nodes {
              id
              fieldValueByName(name: "Status") {
                ... on ProjectV2ItemFieldSingleSelectValue {
                  name
                  optionId
                }
              }
              content {
                ... on Issue {
                  number
                  title
                  body
                  url
                  repository {
                    nameWithOwner
                  }
                  comments(last: 50) {
                    nodes {
                      databaseId
                      author { login }
                      body
                      createdAt
                    }
                  }
                }
              }
            }
          }
        }
      }
    }""", {"owner": owner, "number": number}, cfg)
    return data["user"]["projectV2"]["items"]["nodes"]


def move_card(item_id, status_name, cfg):
    """Move a project card to the given status column."""
    project_id = cfg["project"]["id"]
    field_id   = cfg["project"]["status_field_id"]
    option_id  = cfg["project"]["columns"][status_name.lower().replace(" ", "_")]
    gql("""
    mutation($projectId: ID!, $itemId: ID!, $fieldId: ID!, $optionId: String!) {
      updateProjectV2ItemFieldValue(input: {
        projectId: $projectId
        itemId: $itemId
        fieldId: $fieldId
        value: { singleSelectOptionId: $optionId }
      }) {
        projectV2Item { id }
      }
    }""", {
        "projectId": project_id,
        "itemId":    item_id,
        "fieldId":   field_id,
        "optionId":  option_id,
    }, cfg)
    log(f"  Moved card to {status_name}")


def invoke_claude(prompt, issue, cfg, cwd=None):
    """Invoke Claude non-interactively with the project-workflow skill available.

    Returns a claude_runner status. Failures are logged with an ERROR: prefix and,
    for credential failures, flagged as a comment on the issue.
    """
    return claude_runner.run_claude(
        prompt,
        bot_env(cfg),
        cwd=cwd or Path.home(),
        target={"repo": issue["repository"]["nameWithOwner"],
                "number": issue["number"]},
        bot_login=cfg["github"]["bot_login"],
        log=log,
        model=parse_requested_model(issue.get("body")),
    )


def is_plan_comment(comment):
    """True if this bot comment is a posted plan (or iterate response).

    A comment counts as a plan when it carries the plan-finished sentinel, or —
    for the cards that predate the sentinels — when it carries no `pf:` sentinel
    and is not one of the bot's other first-line markers.
    """
    body = (comment["body"] or "").lstrip()
    if body.startswith(PLAN_FINISH):
        return True
    return not body.startswith(NON_PLAN_MARKERS)


def handle_plan(item_id, issue, cfg):
    number    = issue["number"]
    repo      = issue["repository"]["nameWithOwner"]
    comments  = issue["comments"]["nodes"]
    bot_login = cfg["github"]["bot_login"]
    bot_comments  = [c for c in comments if c["author"]["login"] == bot_login]
    user_comments = [c for c in comments if c["author"]["login"] != bot_login]

    # `plan` and `iterate` occupy the same slot in the state machine, so they
    # share one marker pair. Without this guard the column had the mirror-image
    # failure of the other two: a run that died before posting left no comment,
    # so every subsequent poll re-dispatched it indistinguishably from the first.
    if check_in_flight("Plan", issue, bot_comments,
                       PLAN_START_MARKERS, PLAN_FINISH_MARKERS, cfg):
        return None

    # Deliberately "a plan exists", not "a bot comment exists": the start marker
    # must not count as a plan, or a dead plan run would park the card in the
    # iterate branch waiting for feedback on a plan that was never posted.
    plan_comments = [c for c in bot_comments if is_plan_comment(c)]

    if not plan_comments:
        log(f"  Plan: no plan yet for issue #{number}, creating")
        return invoke_claude(
            f"Use the project-workflow skill. Action: plan. "
            f"Issue #{number} in {repo} is in the Plan column and has no plan yet.",
            issue, cfg
        )
    else:
        last_plan_time = max(c["createdAt"] for c in plan_comments)
        owner_login    = cfg["github"]["org"]
        new_user_comments = [
            c for c in user_comments
            if c["createdAt"] > last_plan_time and c["author"]["login"] == owner_login
        ]
        if new_user_comments:
            log(f"  Plan: {len(new_user_comments)} new comment(s) on issue #{number}, responding")
            return invoke_claude(
                f"Use the project-workflow skill. Action: iterate. "
                f"Issue #{number} in {repo} is in the Plan column and has new user comments to respond to.",
                issue, cfg
            )
        else:
            log(f"  Plan: no new comments on issue #{number}, waiting")
    return None


def handle_implement(item_id, issue, cfg):
    number    = issue["number"]
    repo      = issue["repository"]["nameWithOwner"]
    comments  = issue["comments"]["nodes"]
    bot_login = cfg["github"]["bot_login"]
    bot_comments = [c for c in comments if c["author"]["login"] == bot_login]

    if check_in_flight("Implement", issue, bot_comments,
                       IMPL_START_MARKERS, IMPL_FINISH_MARKERS, cfg):
        return None

    log(f"  Implement: starting issue #{number}")
    repos_root = Path(cfg["repos"]["root"]).expanduser()
    repo_name  = repo.split("/")[-1]
    repo_path  = repos_root / repo_name
    return invoke_claude(
        f"Use the project-workflow skill. Action: implement. "
        f"Issue #{number} in {repo} is in the Implement column. "
        f"Project item ID: {item_id}.",
        issue, cfg,
        repo_path if repo_path.exists() else None
    )


def get_linked_prs(repo, issue_number, cfg):
    """Find open or merged PRs that reference this issue via REST timeline."""
    result = subprocess.run(
        ["gh", "api", f"repos/{repo}/issues/{issue_number}/timeline",
         "--paginate", "--jq",
         "[.[] | select(.event==\"cross-referenced\") "
         "| select(.source.issue.pull_request != null) "
         "| .source.issue | {number: .number, state: .state, repo: .repository.full_name, merged: (.pull_request.merged_at != null)}]"],
        capture_output=True, text=True, env=bot_env(cfg)
    )
    if result.returncode != 0:
        return []
    try:
        return json.loads(result.stdout)
    except Exception:
        return []


def get_pr_review_decision(repo, pr_number, cfg):
    """Return 'APPROVED' if the PR has any APPROVED review.

    GitHub only sets reviewDecision="APPROVED" when branch protection requires
    reviews. Without that setting it returns "", so we fall back to the reviews array.
    """
    result = subprocess.run(
        ["gh", "pr", "view", str(pr_number), "-R", repo,
         "--json", "reviewDecision,reviews"],
        capture_output=True, text=True, env=bot_env(cfg)
    )
    if result.returncode != 0:
        return None
    try:
        data        = json.loads(result.stdout)
        owner_login = cfg["github"]["org"]
        if any(r.get("state") == "APPROVED" and r.get("author", {}).get("login") == owner_login
               for r in data.get("reviews", [])):
            return "APPROVED"
        return data.get("reviewDecision") or "PENDING"
    except Exception:
        return None


def handle_in_review(item_id, issue, cfg):
    """Invoke done action when all linked open PRs are approved."""
    repo      = issue["repository"]["nameWithOwner"]
    number    = issue["number"]
    comments  = issue["comments"]["nodes"]
    bot_login = cfg["github"]["bot_login"]
    bot_comments = [c for c in comments if c["author"]["login"] == bot_login]

    if check_in_flight("In Review", issue, bot_comments,
                       DONE_START_MARKERS, DONE_FINISH_MARKERS, cfg):
        return None

    prs      = get_linked_prs(repo, number, cfg)
    open_prs = [pr for pr in prs if pr.get("state") == "open"]
    if not open_prs:
        return None

    decisions = [get_pr_review_decision(pr.get("repo", repo), pr["number"], cfg) for pr in open_prs]
    if not all(d == "APPROVED" for d in decisions):
        log(f"  In Review: not all PRs approved for #{number}, waiting")
        return None

    log(f"  In Review: all PRs approved for #{number}, invoking done action")
    pr_list    = ", ".join(f"#{pr['number']} in {pr.get('repo', repo)}" for pr in open_prs)
    repos_root = Path(cfg["repos"]["root"]).expanduser()
    repo_name  = repo.split("/")[-1]
    repo_path  = repos_root / repo_name
    return invoke_claude(
        f"Use the project-workflow skill. Action: done. "
        f"Issue #{number} in {repo} has all PRs approved. "
        f"PRs to merge: {pr_list}. "
        f"Project item ID: {item_id}.",
        issue, cfg,
        repo_path if repo_path.exists() else None
    )


def main():
    if LOCK_FILE.exists():
        pid = LOCK_FILE.read_text().strip()
        if pid.isdigit() and Path(f"/proc/{pid}").exists():
            log("Lock held by live process — skipping")
            return
        log("Stale lock — clearing")
        LOCK_FILE.unlink()
    LOCK_FILE.write_text(str(os.getpid()))
    try:
        cfg   = load_config()
        items = get_plan_items(cfg)
        active = [
            i for i in items
            if i.get("fieldValueByName")
            and i["fieldValueByName"].get("name") in ("Plan", "Implement", "In Review")
            and i.get("content")
        ]

        if not active:
            log("No active items")
            return

        log(f"Found {len(active)} active item(s)")

        for item in active:
            status = item["fieldValueByName"]["name"]
            issue  = item["content"]
            log(f"  #{issue['number']} '{issue['title']}' [{status}]")

            if status == "Plan":
                outcome = handle_plan(item["id"], issue, cfg)
            elif status == "Implement":
                outcome = handle_implement(item["id"], issue, cfg)
            elif status == "In Review":
                outcome = handle_in_review(item["id"], issue, cfg)
            else:
                outcome = None

            if outcome is not None and outcome != claude_runner.OK:
                log(f"  Card #{issue['number']} not advanced ({outcome})")

    except Exception as e:
        log(f"ERROR: {e}")
        raise
    finally:
        LOCK_FILE.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
